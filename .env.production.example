# Copy to .env.production; configure HTTPS reverse proxy before login.
PORT=3000
HTTP_HOST=127.0.0.1
PLATFORM_DATABASE=data/production/platform.db
COOKIE_SECURE=1
# Enable only after configuring a device-reachable SIP/RTP address.
SIP_ENABLED=0
SIP_HOST=127.0.0.1
SIP_PUBLIC_IP=127.0.0.1
SIP_PORT=8116
SIP_DOMAIN=4101050000
SIP_ID=41010500002000000001
MEDIA_URL=
MEDIA_SECRET=
MEDIA_HOOK_TOKEN=
MEDIA_RTP_HOST=127.0.0.1
