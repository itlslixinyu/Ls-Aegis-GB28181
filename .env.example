PORT=3000
SIP_ENABLED=0
SIP_HOST=127.0.0.1
SIP_PORT=8116
SIP_DOMAIN=4101050000
SIP_ID=41010500002000000001
# Set only behind HTTPS in deployment:
COOKIE_SECURE=0
# ZLMediaKit administration endpoint and secret.
MEDIA_URL=
MEDIA_SECRET=

# Advertised SIP address and RTP destination must be reachable by devices.
SIP_PUBLIC_IP=127.0.0.1
MEDIA_RTP_HOST=127.0.0.1
# Optional: local interface address on the media node, independent of the SIP advertised address.
MEDIA_RTP_BIND_IP=
# Backend-only HTTP media URL; defaults to MEDIA_URL.
MEDIA_PLAY_URL=
# Required for complete device-recording exports; use an independent random token.
MEDIA_HOOK_TOKEN=
# Backend-only MP4 HTTP path template (adapt if ZLM uses virtual-host paths).
MEDIA_RECORD_PATH=/record/rtp/{stream}/{date}/{file}

# Optional self-hosted XYZ raster map tiles; blank uses a labelled WGS84 grid.
# Example: https://tiles.example.org/{z}/{x}/{y}.png
MAP_TILE_URL=
MAP_ATTRIBUTION=

# Device-reported position history retention, 1..365 days.
POSITION_RETENTION_DAYS=30

# 历史录像按需检索专用工具；不改变实时转码配置。ffprobe需与ffmpeg同目录。
# AI_ARCHIVE_FFMPEG_EXECUTABLE=C:/ffmpeg/bin/ffmpeg.exe
# Docker工具读取回环媒体时，可指定容器可达的媒体主机。
# AI_ARCHIVE_MEDIA_HOST=host.docker.internal
# 本地历史检索模型目录。先运行 npm run ai:setup；请求不会自动下载模型。
# AI_LOCAL_MODEL_DIR=D:/监控管理软件/data/ai-models/clip-vit-base-patch32
# 本地媒体节点不提供HTTP文件版本头时，可显式映射录像目录，仅用于stat校验缓存。
# AI_ARCHIVE_LOCAL_ROOT=D:/监控管理软件/data/media/recordings
# AI_ARCHIVE_LOCAL_URL_PREFIX=/record/
# 移动侦测抓图默认开启，仅复用已有就绪视频源；设0停用，重启生效。
# ALARM_SNAPSHOT_ENABLED=0
